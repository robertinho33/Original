# AUREA ADMIN
#
# NÃO coloque o valor real neste arquivo.
#
# PowerShell:
#
# $env:AUREA_ADMIN_TOKEN = "COLOQUE_UM_TOKEN_FORTE_AQUI"
#
# Produção:
#
# AUREA_ADMIN_TOKEN=<segredo-do-ambiente>

# WhatsApp Business Cloud API: configure after approving a Utility template
# with {{1}} for the customer name and {{2}} for the single-line confirmation
# (real order number, awaiting payment confirmation, private tracking link).
# Never place access tokens in frontend files or commit .env.
NEFER_WHATSAPP_ACCESS_TOKEN=
NEFER_WHATSAPP_ENABLED=false
NEFER_WHATSAPP_PHONE_NUMBER_ID=
NEFER_WHATSAPP_ORDER_TEMPLATE=
NEFER_WHATSAPP_ADMIN_TEMPLATE=
NEFER_WHATSAPP_INFLUENCER_TEMPLATE=
NEFER_WHATSAPP_ADMIN_PHONE=+5511986215473
NEFER_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
NEFER_WHATSAPP_GRAPH_API_VERSION=
PUBLIC_STORE_URL=https://www.fiosperfeitos.com.br
# Mercado Pago Checkout Pro: manter desligado até testes completos.
MP_CHECKOUT_ENABLED=false
MP_MODE=test
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=
MP_PRODUCTION_VALIDATED=false
MP_PRODUCTION_ACCESS_TOKEN=
MP_PRODUCTION_WEBHOOK_SECRET=
MP_PRODUCTION_COLLECTOR_ID=
MP_REAL_SALE_TEST_ONLY=false
MP_REAL_SALE_TEST_SKU=
MP_REAL_SALE_TEST_MAX_TOTAL=

# Liberação de cartões para todo o catálogo, mantendo validação de conta e estoque.
MP_CATALOG_CARD_ENABLED=false

# Correios: configure securely in the server environment, never in frontend files.
SHIPPING_PROVIDER=correios
# Use melhor_envio only after connecting an authorized production account.
MELHOR_ENVIO_TOKEN=
# OAuth application: configure private credentials in Render, never commit real values.
MELHOR_ENVIO_AUTH_MODE=token
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# 32 random bytes encoded as 64 hex characters; encrypts stored access/refresh tokens.
MELHOR_ENVIO_TOKEN_ENCRYPTION_KEY=
MELHOR_ENVIO_USER_AGENT=Fios Perfeitos (robertinho33@gmail.com)
SHIPPING_PACKAGE_MAX_WEIGHT_GRAMS=2000
# Authorized rule: fixed TOTAL package weight, including box. Use actual for SKU weights.
SHIPPING_WEIGHT_MODE=fixed
SHIPPING_PACKAGE_FIXED_WEIGHT_GRAMS=2000
CORREIOS_ORIGIN_CEP=04883000
CORREIOS_USERNAME=
CORREIOS_ACCESS_CODE=
CORREIOS_CONTRACT=
CORREIOS_DR=
CORREIOS_SERVICE_CODES=03298,03220,03158,03140
# Actual standard package measurements, tare and safe capacity must be confirmed.
CORREIOS_PACKAGE_LENGTH_CM=16
CORREIOS_PACKAGE_WIDTH_CM=24
CORREIOS_PACKAGE_HEIGHT_CM=8
CORREIOS_PACKAGE_TARE_GRAMS=40
CORREIOS_PACKAGE_MAX_ITEMS=4
CORREIOS_PREPARATION_DAYS=3
# Each server-side product also requires shippingWeightGrams (real packed product weight).

# PIX na loja: false mantém o redirecionamento anterior.
MP_EMBEDDED_PIX_ENABLED=false
# Template Utility aprovado: duas variáveis, nome do destinatário e resumo do pedido pago.
NEFER_WHATSAPP_PAID_TEMPLATE=
