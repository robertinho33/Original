# AUREA ADMIN
#
# NÃO coloque o valor real neste arquivo.
#
# PowerShell:
#
# $env:AUREA_ADMIN_TOKEN = "COLOQUE_UM_TOKEN_FORTE_AQUI"
#
# Produção:
#
# AUREA_ADMIN_TOKEN=<segredo-do-ambiente>

# WhatsApp Business Cloud API: configure after approving a Utility template
# with {{1}} for the customer name and {{2}} for order details.
NEFER_WHATSAPP_ACCESS_TOKEN=
NEFER_WHATSAPP_PHONE_NUMBER_ID=
NEFER_WHATSAPP_ORDER_TEMPLATE=
NEFER_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
NEFER_WHATSAPP_GRAPH_API_VERSION=
PUBLIC_STORE_URL=https://www.fiosperfeitos.com.br