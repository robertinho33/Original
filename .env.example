# AUREA ADMIN
#
# NÃO coloque o valor real neste arquivo.
#
# PowerShell:
#
# $env:AUREA_ADMIN_TOKEN = "COLOQUE_UM_TOKEN_FORTE_AQUI"
#
# Produção:
#
# AUREA_ADMIN_TOKEN=<segredo-do-ambiente>

# WhatsApp Business Cloud API: configure after approving a Utility template
# with {{1}} for the customer name and {{2}} for the single-line confirmation
# (real order number, awaiting payment confirmation, private tracking link).
# Never place access tokens in frontend files or commit .env.
NEFER_WHATSAPP_ACCESS_TOKEN=
NEFER_WHATSAPP_PHONE_NUMBER_ID=
NEFER_WHATSAPP_ORDER_TEMPLATE=
NEFER_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
NEFER_WHATSAPP_GRAPH_API_VERSION=
PUBLIC_STORE_URL=https://www.fiosperfeitos.com.br
# Mercado Pago Checkout Pro: manter desligado até testes completos.
MP_CHECKOUT_ENABLED=false
MP_MODE=test
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=
MP_PRODUCTION_VALIDATED=false