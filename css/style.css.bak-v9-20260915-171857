@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap');

:root{--ink:#1c1b19;--muted:#77736d;--paper:#f7f4ee;--cream:#eee7db;--line:#ddd7cd;--accent:#9b6b4b;--white:#fff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",sans-serif}
a{text-decoration:none;color:inherit}button{font:inherit;border:0;background:none;cursor:pointer;color:inherit}
.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);position:sticky;top:0;background:rgba(247,244,238,.9);backdrop-filter:blur(14px);z-index:10}
.brand{font-size:15px;font-weight:700;letter-spacing:.22em}.brand span{display:inline-grid;place-items:center;width:30px;height:30px;border:1px solid var(--ink);border-radius:50%;margin-right:8px}
nav{display:flex;gap:34px;color:var(--muted);font-size:13px}nav a:hover{color:var(--ink)}
.cart-button{font-size:13px}.cart-button b{display:inline-grid;place-items:center;background:var(--ink);color:var(--paper);width:22px;height:22px;border-radius:50%;margin-left:7px;font-size:11px}
.hero{min-height:calc(100vh - 78px);padding:7vw 6vw;display:grid;grid-template-columns:1fr 1fr;gap:7vw;align-items:center}
.eyebrow{font-size:10px;letter-spacing:.24em;font-weight:700;color:var(--muted);margin:0 0 22px}.hero h1{font-size:clamp(52px,7vw,100px);line-height:.92;letter-spacing:-.05em;margin:0 0 28px;font-weight:500}.hero h1 em,.ritual h2 em{font-family:"Playfair Display",serif;font-weight:500}.hero-text{max-width:480px;color:var(--muted);line-height:1.8;font-size:15px;margin-bottom:34px}
.primary{display:inline-flex;gap:22px;align-items:center;background:var(--ink);color:var(--white);padding:16px 20px;font-size:12px;font-weight:700;transition:.2s}.primary:hover{transform:translateY(-2px)}.primary span{font-size:18px}
.hero-card{height:min(620px,70vh);min-height:450px;background:var(--cream);position:relative;overflow:hidden}.orb{width:70%;aspect-ratio:1;border-radius:50%;background:#d2b49b;position:absolute;left:15%;top:10%;filter:blur(1px)}.product-shape{position:absolute;width:31%;height:58%;background:#f8f1e8;border:1px solid #d7cabc;border-radius:90px 90px 35px 35px;left:34.5%;top:23%;box-shadow:25px 25px 50px #9b765333}.product-shape:before{content:"AURA";position:absolute;top:45%;left:0;right:0;text-align:center;font-size:9px;letter-spacing:.25em}.floating-note{position:absolute;bottom:30px;left:30px;font-size:10px;line-height:1.6;letter-spacing:.15em}.floating-note strong{font-family:"Playfair Display";font-size:18px;letter-spacing:0}
.collection{padding:100px 6vw}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:45px}.section-head h2{font-size:clamp(34px,4vw,58px);letter-spacing:-.04em;margin:0}.filters{display:flex;gap:22px}.filters button{font-size:12px;color:var(--muted);padding-bottom:7px;border-bottom:1px solid transparent}.filters button.active,.filters button:hover{color:var(--ink);border-color:var(--ink)}
.products{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.product{background:#fff;min-width:0}.product-visual{aspect-ratio:1/1.15;background:var(--cream);position:relative;display:grid;place-items:center;overflow:hidden}.product-visual:after{content:"";width:42%;height:63%;background:#eee7de;border:1px solid #d4c9bc;border-radius:55px 55px 20px 20px;box-shadow:15px 18px 30px #75624a22}.product:nth-child(2n) .product-visual:after{width:52%;height:42%;border-radius:20px}.product:nth-child(3n) .product-visual:after{width:28%;height:70%;border-radius:80px}.tag{position:absolute;left:12px;top:12px;background:#fff;padding:7px 9px;font-size:9px;letter-spacing:.12em;z-index:1}.product-info{padding:18px}.product-info h3{font-size:14px;margin:0 0 7px}.product-info p{font-size:11px;color:var(--muted);margin:0 0 15px}.product-bottom{display:flex;align-items:center;justify-content:space-between}.price{font-weight:700;font-size:13px}.add{width:32px;height:32px;border:1px solid var(--line);font-size:18px}.add:hover{background:var(--ink);color:#fff}
.ritual{background:var(--ink);color:#fff;padding:100px 6vw;display:grid;grid-template-columns:1fr 1.5fr;gap:8vw}.ritual .eyebrow{color:#aaa}.ritual h2{font-size:clamp(42px,5vw,70px);font-weight:500;line-height:1;margin:0}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.steps article{border-top:1px solid #555;padding-top:20px}.steps span{font-size:10px;color:#aaa}.steps h3{font-size:17px;margin:45px 0 10px}.steps p{font-size:12px;color:#aaa;line-height:1.7}
.manifesto{padding:130px 12vw;text-align:center}.manifesto blockquote{font-family:"Playfair Display";font-size:clamp(34px,5vw,64px);line-height:1.1;max-width:900px;margin:0 auto 35px}.manifesto>p:last-child{max-width:500px;margin:auto;color:var(--muted);line-height:1.7;font-size:13px}
footer{padding:25px 6vw;border-top:1px solid var(--line);display:flex;justify-content:space-between;color:var(--muted);font-size:10px;letter-spacing:.1em}
.drawer{position:fixed;right:0;top:0;width:min(440px,100%);height:100vh;background:var(--paper);z-index:30;transform:translateX(100%);transition:.3s;display:flex;flex-direction:column}.drawer.open{transform:translateX(0)}.drawer-head{display:flex;justify-content:space-between;padding:28px;border-bottom:1px solid var(--line)}.drawer-head h2{margin:0;font-size:20px}.drawer-head button{font-size:28px}.cart-items{padding:20px 28px;flex:1;overflow:auto}.empty{color:var(--muted);font-size:13px;text-align:center;margin-top:80px}.cart-row{display:grid;grid-template-columns:60px 1fr auto;gap:14px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line)}.mini{width:60px;height:70px;background:var(--cream)}.cart-row h4{margin:0 0 5px;font-size:12px}.cart-row small{color:var(--muted)}.remove{font-size:11px;color:var(--muted)}.cart-footer{padding:28px;border-top:1px solid var(--line)}.cart-footer>div{display:flex;justify-content:space-between;margin-bottom:20px}.checkout{width:100%;justify-content:center}.backdrop{position:fixed;inset:0;background:#0008;z-index:20;opacity:0;pointer-events:none;transition:.3s}.backdrop.show{opacity:1;pointer-events:auto}
@media(max-width:850px){nav{display:none}.hero{grid-template-columns:1fr;padding-top:60px}.hero-card{height:480px}.products{grid-template-columns:repeat(2,1fr)}.ritual{grid-template-columns:1fr}.steps{grid-template-columns:1fr}.section-head{align-items:start;gap:30px;flex-direction:column}.filters{overflow:auto;width:100%;padding-bottom:4px}.collection{padding-top:70px}}
@media(max-width:520px){.topbar{padding:0 20px}.hero,.collection,.ritual{padding-left:20px;padding-right:20px}.hero-card{min-height:360px;height:65vh}.products{grid-template-columns:1fr 1fr;gap:10px}.product-info{padding:12px}.product-info h3{font-size:12px}.manifesto{padding:90px 25px}footer{padding:20px;gap:15px;flex-direction:column}}

/* =========================================================
   CATLOGO  IMAGENS REAIS
   ========================================================= */

.product-image {
    position: absolute;
    inset: 8%;
    width: 84%;
    height: 84%;
    object-fit: contain;
    z-index: 2;
}

.product-visual:has(.product-image)::after {
    display: none;
}

.mini {
    overflow: hidden;
    display: grid;
    place-items: center;
}

.mini img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.cart-product-info {
    min-width: 0;
}

.quantity-control {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
}

.quantity-control button {
    width: 24px;
    height: 24px;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    line-height: 1;
}

.quantity-control button:hover {
    background: var(--ink);
    color: var(--white);
}

.quantity-control span {
    min-width: 16px;
    text-align: center;
    font-size: 12px;
}

.catalog-empty,
.catalog-error {
    grid-column: 1 / -1;
    padding: 60px 20px;
    text-align: center;
    color: var(--muted);
}

.catalog-error h3 {
    color: var(--ink);
    margin-bottom: 10px;
}

.catalog-error p {
    margin: 0;
    line-height: 1.7;
}

/* =========================================================
   ETAPA 2/7  SACOLA PROFISSIONAL
   ========================================================= */

.cart-summary-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;

    padding: 14px 0;

    border-bottom: 1px solid var(--line);

    color: var(--muted);
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.cart-summary-top span:first-child {
    color: var(--text);
    font-weight: 600;
}

.cart-row {
    position: relative;

    display: grid;
    grid-template-columns: 76px 1fr auto;

    gap: 14px;

    align-items: start;

    padding: 18px 0;

    border-bottom: 1px solid var(--line);
}

.mini {
    width: 76px;
    height: 92px;

    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: var(--soft);
}

.mini img {
    width: 100%;
    height: 100%;

    object-fit: contain;

    display: block;
}

.cart-product-info {
    min-width: 0;

    display: flex;
    flex-direction: column;

    gap: 6px;
}

.cart-product-info h4 {
    margin: 0;

    color: var(--text);

    font-size: 14px;
    line-height: 1.35;
    font-weight: 600;
}

.cart-product-info small {
    color: var(--muted);

    font-size: 12px;
}

.cart-product-info > strong {
    margin-top: 2px;

    color: var(--text);

    font-size: 14px;
}

.quantity-control {
    width: fit-content;

    display: inline-flex;
    align-items: center;

    border: 1px solid var(--line);
    border-radius: 999px;

    overflow: hidden;

    background: #fff;
}

.quantity-control button {
    width: 30px;
    height: 30px;

    padding: 0;

    border: 0;

    background: transparent;

    color: var(--text);

    font-size: 16px;

    cursor: pointer;

    transition:
        background .2s ease,
        color .2s ease;
}

.quantity-control button:hover {
    background: var(--soft);
}

.quantity-control span {
    min-width: 30px;

    text-align: center;

    color: var(--text);

    font-size: 13px;
    font-weight: 600;
}

.remove {
    align-self: start;

    padding: 4px 0;

    border: 0;

    background: transparent;

    color: var(--muted);

    font-size: 11px;

    cursor: pointer;

    transition: color .2s ease;
}

.remove:hover {
    color: var(--text);
}

.cart-footer {
    padding-top: 20px;
}

.cart-total-line {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;
}

.cart-total-line span {
    color: var(--muted);

    font-size: 13px;
}

.cart-total-line strong {
    color: var(--text);

    font-size: 20px;
    font-weight: 600;
}

.cart-note {
    margin: 10px 0 18px;

    color: var(--muted);

    font-size: 11px;
    line-height: 1.5;
}

.checkout {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 12px;
}

.catalog-empty,
.catalog-error {
    grid-column: 1 / -1;

    padding: 50px 20px;

    text-align: center;

    border: 1px solid var(--line);
    border-radius: 18px;

    background: var(--soft);
}

.catalog-empty p,
.catalog-error p {
    margin: 0;

    color: var(--muted);
}

.catalog-error h3 {
    margin: 0 0 8px;

    color: var(--text);

    font-size: 18px;
}

@media (max-width: 520px) {

    .cart-row {
        grid-template-columns: 64px 1fr;

        gap: 12px;
    }

    .mini {
        width: 64px;
        height: 80px;
    }

    .remove {
        grid-column: 2;
        justify-self: start;
    }

    .cart-total-line strong {
        font-size: 18px;
    }

}

/* =========================================================
   ETAPA 3/7  PGINA / MODAL DE PRODUTO
   ========================================================= */

.product {
    cursor: pointer;
}

.product:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
}

.product-image {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: contain;
}

.product-image-placeholder {
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--muted);

    font-size: 12px;
    letter-spacing: .12em;
}

.product-weight {
    display: block;

    margin-top: 8px;

    color: var(--muted);

    font-size: 11px;
}

.product-modal {
    position: fixed;
    inset: 0;

    z-index: 2000;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 24px;

    visibility: hidden;
    opacity: 0;

    pointer-events: none;

    transition:
        opacity .25s ease,
        visibility .25s ease;
}

.product-modal.open {
    visibility: visible;
    opacity: 1;

    pointer-events: auto;
}

.product-modal-backdrop {
    position: absolute;
    inset: 0;

    background: rgba(20, 18, 16, .58);

    backdrop-filter: blur(8px);
}

.product-modal-panel {
    position: relative;

    z-index: 1;

    width: min(980px, 100%);

    max-height: min(720px, 90vh);
    background: #f8f5f0;

    overflow: auto;

    border-radius: 24px;

    background: var(--bg);

    box-shadow:
        0 30px 80px rgba(0, 0, 0, .22);

    transform: translateY(18px) scale(.98);

    transition: transform .25s ease;
}

.product-modal.open .product-modal-panel {
    transform: translateY(0) scale(1);
}

.product-modal-close {
    position: absolute;

    top: 18px;
    right: 18px;

    z-index: 3;

    width: 40px;
    height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid var(--line);
    border-radius: 50%;

    background: rgba(255, 255, 255, .86);

    color: var(--text);

    font-size: 24px;
    line-height: 1;

    cursor: pointer;

    transition:
        background .2s ease,
        transform .2s ease;
}

.product-modal-close:hover {
    background: #fff;

    transform: rotate(5deg);
}

.product-modal-content {
    display: grid;

    grid-template-columns:
        minmax(300px, .95fr)
        minmax(320px, 1.05fr);
}

.product-modal-image {
    min-height: 560px;

    overflow: hidden;

    background: var(--soft);
}

.product-modal-image img {
    width: 100%;
    height: 100%;

    min-height: 560px;

    display: block;

    object-fit: contain;
}

.product-modal-details {
    display: flex;
    flex-direction: column;

    justify-content: center;

    padding: 64px 56px;
}

.product-modal-details .eyebrow {
    margin-bottom: 12px;
}

.product-modal-details h2 {
    margin: 0;

    max-width: 520px;

    color: var(--text);

    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.05;
    letter-spacing: -.03em;
}

.product-modal-description {
    margin: 24px 0 0;

    max-width: 560px;

    color: var(--muted);

    font-size: 14px;
    line-height: 1.75;

    white-space: pre-line;
}

.product-modal-meta {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 12px;

    margin-top: 30px;
}

.product-modal-meta > div {
    padding: 14px 16px;

    border: 1px solid var(--line);
    border-radius: 12px;

    background: var(--soft);
}

.product-modal-meta span,
.product-modal-price span {
    display: block;

    margin-bottom: 6px;

    color: var(--muted);

    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
}

.product-modal-meta strong {
    display: block;

    color: var(--text);

    font-size: 13px;
    line-height: 1.4;
}

.product-modal-purchase {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 20px;

    margin-top: 30px;
}

.product-modal-price strong {
    display: block;

    color: var(--text);

    font-size: 25px;
    font-weight: 600;
}

.modal-quantity {
    display: inline-flex;
    align-items: center;

    border: 1px solid var(--line);
    border-radius: 999px;

    overflow: hidden;

    background: #fff;
}

.modal-quantity button {
    width: 38px;
    height: 38px;

    padding: 0;

    border: 0;

    background: transparent;

    color: var(--text);

    font-size: 18px;

    cursor: pointer;

    transition: background .2s ease;
}

.modal-quantity button:hover {
    background: var(--soft);
}

.modal-quantity span {
    min-width: 34px;

    text-align: center;

    color: var(--text);

    font-size: 13px;
    font-weight: 600;
}

.product-modal-add {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 12px;

    margin-top: 24px;
}

body.modal-open {
    overflow: hidden;
}

@media (max-width: 850px) {

    .product-modal {
        padding: 16px;
    }

    .product-modal-panel {
        max-height: 94vh;
    }

    .product-modal-content {
        grid-template-columns: 1fr;
    }

    .product-modal-image {
        min-height: 320px;
        max-height: 360px;
    }

    .product-modal-image img {
        min-height: 320px;
        max-height: 360px;
    }

    .product-modal-details {
        padding: 38px 28px 30px;
    }

}

@media (max-width: 520px) {

    .product-modal {
        padding: 0;
    }

    .product-modal-panel {
        width: 100%;
        max-height: 100vh;

        border-radius: 0;
    }

    .product-modal-image {
        min-height: 280px;
        max-height: 300px;
    }

    .product-modal-image img {
        min-height: 280px;
        max-height: 300px;
    }

    .product-modal-details {
        padding: 30px 20px 24px;
    }

    .product-modal-details h2 {
        font-size: 30px;
    }

    .product-modal-description {
        margin-top: 18px;

        font-size: 13px;
    }

    .product-modal-meta {
        margin-top: 20px;
    }

    .product-modal-purchase {
        align-items: center;
    }

}

/* =========================================================
   ETAPA 3/7  AJUSTE FINAL DO MODAL
   ========================================================= */
.product-modal-details {
    background: #f8f5f0;
}
