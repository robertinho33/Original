:root {
  --bg: #f5f4f0;
  --surface: #ffffff;
  --sidebar: #20201d;
  --text: #20201d;
  --muted: #77766e;
  --border: #e5e3dc;
  --accent: #9b8060;
  --accent-soft: #f1e9df;
  --success: #47765b;
  --warning: #a47735;
  --info: #55738b;
  --danger: #9a4e4e;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

button,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.admin-app {
  display: grid;
  grid-template-columns: 250px minmax(0, 1fr);
  min-height: 100vh;
}


/* SIDEBAR */

.admin-sidebar {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 24px 16px;
  background: var(--sidebar);
  color: white;
}

.admin-brand {
  padding: 5px 12px 25px;
}

.admin-brand strong {
  display: block;
  font-size: 22px;
  letter-spacing: .16em;
}

.admin-brand span {
  display: block;
  margin-top: 5px;
  color: #a6a59d;
  font-size: 9px;
  letter-spacing: .15em;
}

.admin-nav {
  display: grid;
  gap: 3px;
}

.admin-nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 11px;
  border: 0;
  border-radius: 9px;
  padding: 11px 12px;
  background: transparent;
  color: #aaa9a1;
  text-align: left;
  font-size: 12px;
  transition: .18s ease;
}

.admin-nav-item:hover {
  background: rgba(255,255,255,.06);
  color: white;
}

.admin-nav-item.active {
  background: var(--accent);
  color: white;
}

.admin-nav-item span {
  width: 20px;
  text-align: center;
}

.admin-sidebar-footer {
  margin-top: auto;
}

.admin-user {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 10px;
  border-top: 1px solid rgba(255,255,255,.08);
}

.admin-user strong,
.admin-user span {
  display: block;
}

.admin-user strong {
  font-size: 11px;
}

.admin-user span {
  margin-top: 3px;
  color: #92918a;
  font-size: 9px;
}

.admin-avatar {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  flex: 0 0 35px;
  border-radius: 50%;
  background: var(--accent);
  color: white;
  font-size: 12px;
  font-weight: 700;
}

.admin-logout {
  width: 100%;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 8px;
  padding: 9px;
  background: transparent;
  color: #aaa9a1;
  font-size: 11px;
}


/* HEADER */

.admin-main {
  min-width: 0;
}

.admin-header {
  min-height: 88px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 20px 30px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}

.admin-header h1 {
  margin: 0;
  font-size: 24px;
}

.admin-header p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 11px;
}

.admin-header-actions {
  display: flex;
  align-items: center;
  gap: 13px;
}

.admin-icon-button {
  width: 39px;
  height: 39px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: white;
}

.admin-profile {
  display: flex;
  align-items: center;
  gap: 8px;
}

.admin-profile strong,
.admin-profile span {
  display: block;
}

.admin-profile strong {
  font-size: 11px;
}

.admin-profile span {
  margin-top: 2px;
  color: var(--muted);
  font-size: 9px;
}


/* CONTENT */

.admin-content {
  padding: 28px 30px 45px;
}

.admin-section {
  display: none;
}

.admin-section.active {
  display: block;
}


/* METRICS */

.admin-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 14px;
}

.metric-card {
  padding: 19px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
}

.metric-card span,
.metric-card small {
  display: block;
  color: var(--muted);
}

.metric-card span {
  font-size: 10px;
}

.metric-card strong {
  display: block;
  margin-top: 9px;
  font-size: 24px;
}

.metric-card small {
  margin-top: 7px;
  font-size: 9px;
}


/* GRID */

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(280px, .55fr);
  gap: 14px;
  margin-bottom: 14px;
}


/* PANELS */

.admin-panel {
  min-width: 0;
  padding: 18px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 17px;
}

.panel-header h2 {
  margin: 0;
  font-size: 14px;
}

.panel-header span {
  display: block;
  margin-top: 4px;
  color: var(--muted);
  font-size: 9px;
}

.panel-header select {
  border: 1px solid var(--border);
  border-radius: 7px;
  padding: 7px 9px;
  background: white;
  font-size: 10px;
}


/* CHART */

.sales-chart {
  height: 225px;
  display: flex;
  align-items: end;
  gap: 13px;
  padding: 15px 8px 0;
  border-bottom: 1px solid var(--border);
}

.chart-column {
  height: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: end;
  align-items: center;
  gap: 8px;
}

.chart-column span {
  color: var(--muted);
  font-size: 8px;
}

.chart-bar {
  width: 100%;
  max-width: 42px;
  min-height: 20px;
  border-radius: 7px 7px 0 0;
  background: var(--accent-soft);
  border: 1px solid #cdb99e;
}

.chart-bar.active {
  background: var(--accent);
}


/* OPERATION */

.operation-list {
  display: grid;
}

.operation-list div {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 13px 0;
  border-bottom: 1px solid var(--border);
}

.operation-list div:last-child {
  border-bottom: 0;
}

.operation-list span {
  color: var(--muted);
  font-size: 10px;
}

.operation-list strong {
  font-size: 14px;
}


/* TABLE */

.table-wrapper {
  overflow-x: auto;
}

.admin-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 10px;
}

.admin-table th {
  padding: 10px 8px;
  border-bottom: 1px solid var(--border);
  color: var(--muted);
  text-align: left;
  font-weight: 500;
}

.admin-table td {
  padding: 12px 8px;
  border-bottom: 1px solid var(--border);
}

.status {
  display: inline-flex;
  padding: 5px 8px;
  border-radius: 20px;
  font-size: 8px;
  white-space: nowrap;
}

.status.warning {
  background: #f6eddf;
  color: var(--warning);
}

.status.success {
  background: #e5f0e9;
  color: var(--success);
}

.status.info {
  background: #e7eef3;
  color: var(--info);
}


/* BUTTON */

.admin-button {
  border: 1px solid var(--border);
  border-radius: 7px;
  padding: 7px 10px;
  background: white;
  color: var(--text);
  font-size: 9px;
}


/* STOCK */

.stock-list {
  display: grid;
}

.stock-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  padding: 13px 0;
  border-bottom: 1px solid var(--border);
}

.stock-item:last-child {
  border-bottom: 0;
}

.stock-item strong {
  display: block;
  font-size: 10px;
}

.stock-item span {
  display: block;
  margin-top: 4px;
  color: var(--muted);
  font-size: 8px;
}

.stock-item b {
  color: var(--danger);
  font-size: 11px;
}


/* MOBILE */

@media (max-width: 1100px) {

  .admin-app {
    grid-template-columns: 215px minmax(0, 1fr);
  }

  .admin-metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 720px) {

  .admin-app {
    display: block;
  }

  .admin-sidebar {
    min-height: auto;
  }

  .admin-nav {
    grid-template-columns: repeat(2, 1fr);
  }

  .admin-sidebar-footer {
    display: none;
  }

  .admin-header {
    padding: 18px;
  }

  .admin-content {
    padding: 18px;
  }

}

@media (max-width: 480px) {

  .admin-metrics {
    grid-template-columns: 1fr;
  }

  .admin-nav {
    grid-template-columns: 1fr;
  }

  .admin-profile {
    display: none;
  }

}
/* Complementos do AURÉA Admin */

.module-panel {
  min-height: 430px;
}

.module-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.module-toolbar h2 {
  margin: 0;
  font-size: 18px;
}

.module-toolbar p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 10px;
}

.module-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.admin-button.primary {
  border-color: var(--accent);
  background: var(--accent);
  color: white;
}

.empty-module {
  min-height: 300px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 8px;
  border: 1px dashed var(--border);
  border-radius: 12px;
  text-align: center;
}

.empty-module-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 20px;
}

.empty-module strong {
  font-size: 14px;
}

.empty-module span {
  color: var(--muted);
  font-size: 10px;
}

@media (max-width: 650px) {

  .module-toolbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .module-actions {
    width: 100%;
  }

}
/* ============================================================
   AUREA ADMIN — MÓDULOS COMPLETOS
   ============================================================ */

.admin-summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 22px;
}

.admin-summary-grid .admin-metric {
    min-width: 0;
}

.module-subgrid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr);
    gap: 18px;
    margin-bottom: 22px;
}

.module-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
}

.module-card h3 {
    margin: 0 0 16px;
    font-size: 14px;
    font-weight: 600;
}

.module-card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 18px;
}

.module-card-heading h3 {
    margin: 0;
}

.module-card-heading span {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: 10px;
}

.table-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.danger-button {
    color: var(--danger);
    border-color: #ead4d4;
}

.operation-progress {
    display: grid;
    gap: 13px;
}

.operation-progress > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
}

.operation-progress > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
}

.operation-progress span {
    color: var(--muted);
    font-size: 11px;
}

.operation-progress strong {
    font-size: 15px;
}

.logistics-method {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
}

.logistics-method:last-child {
    border-bottom: 0;
}

.logistics-method span {
    color: var(--muted);
    font-size: 11px;
}

.logistics-method strong {
    font-size: 12px;
}

.report-period {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.report-period-button {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    border-radius: 8px;
    padding: 8px 12px;
    cursor: pointer;
    font: inherit;
    font-size: 10px;
}

.report-period-button:hover,
.report-period-button.active {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--text);
}

.report-chart-card {
    min-height: 280px;
}

.report-bars {
    height: 190px;
    display: flex;
    align-items: flex-end;
    gap: 14px;
    padding: 20px 8px 0;
    border-bottom: 1px solid var(--border);
}

.report-bars > div {
    position: relative;
    flex: 1;
    min-width: 18px;
    max-width: 55px;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(
        to top,
        var(--accent),
        #c6ae91
    );
}

.report-bars span {
    position: absolute;
    left: 50%;
    bottom: -22px;
    transform: translateX(-50%);
    font-size: 9px;
    color: var(--muted);
}

.report-status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
}

.report-status-row:last-child {
    border-bottom: 0;
}

.report-status-row span {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
}

.status-dot.success {
    background: var(--success);
}

.status-dot.warning {
    background: var(--warning);
}

.status-dot.info {
    background: var(--info);
}

.status-dot.danger {
    background: var(--danger);
}

.audit-timeline {
    position: relative;
    margin: 0 0 24px;
    padding-left: 20px;
}

.audit-timeline::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 5px;
    bottom: 5px;
    width: 1px;
    background: var(--border);
}

.audit-item {
    position: relative;
    padding: 0 0 20px 20px;
}

.audit-item:last-child {
    padding-bottom: 0;
}

.audit-marker {
    position: absolute;
    left: -19px;
    top: 4px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--surface);
    box-sizing: content-box;
}

.audit-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 15px;
}

.audit-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.audit-top strong {
    font-size: 12px;
}

.audit-top span {
    color: var(--muted);
    font-size: 9px;
}

.audit-content p {
    margin: 9px 0 10px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.6;
}

.settings-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.settings-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
}

.settings-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 15px;
    font-size: 17px;
}

.settings-heading {
    margin-bottom: 20px;
}

.settings-heading h3 {
    margin: 0;
    font-size: 14px;
}

.settings-heading span {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: 10px;
}

.settings-card label {
    display: block;
    margin: 13px 0 6px;
    font-size: 10px;
    color: var(--muted);
}

.admin-input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--text);
    border-radius: 8px;
    padding: 10px 11px;
    outline: none;
    font: inherit;
    font-size: 11px;
}

.admin-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
}

.settings-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
}

.settings-toggle:last-of-type {
    margin-bottom: 18px;
}

.settings-toggle strong {
    display: block;
    font-size: 11px;
}

.settings-toggle span {
    display: block;
    margin-top: 3px;
    color: var(--muted);
    font-size: 9px;
}

.settings-toggle input[type="checkbox"] {
    width: 35px;
    height: 19px;
    accent-color: var(--accent);
    cursor: pointer;
}

.settings-card > .admin-button {
    margin-top: 18px;
}

@media (max-width: 950px) {
    .admin-summary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .module-subgrid {
        grid-template-columns: 1fr;
    }

    .settings-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 650px) {
    .admin-summary-grid {
        grid-template-columns: 1fr;
    }

    .report-period {
        width: 100%;
    }

    .report-period-button {
        flex: 1;
    }

    .audit-top {
        align-items: flex-start;
        flex-direction: column;
        gap: 5px;
    }

    .module-card {
        padding: 15px;
    }

    .settings-card {
        padding: 17px;
    }
}
.admin-loading {
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 8px;
    color: var(--muted);
}

.admin-loading strong {
    color: var(--text);
    font-size: 13px;
}

.admin-loading span {
    font-size: 10px;
}

.admin-loading-spinner {
    width: 28px;
    height: 28px;
    border: 2px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: aurea-spin .8s linear infinite;
    margin-bottom: 8px;
}

@keyframes aurea-spin {
    to {
        transform: rotate(360deg);
    }
}

.admin-error {
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 10px;
    text-align: center;
    border: 1px dashed var(--border);
    border-radius: 12px;
}

.admin-error strong {
    font-size: 13px;
}

.admin-error span {
    max-width: 600px;
    color: var(--muted);
    font-size: 10px;
}

.finance-highlight {
    display: block;
    font-size: 24px;
    margin-top: 5px;
}

.settings-data-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
}

.settings-data-row:last-child {
    border-bottom: 0;
}

.settings-data-row span {
    color: var(--muted);
    font-size: 11px;
}

.settings-data-row strong {
    font-size: 13px;
}

.admin-table-wrap {
    overflow-x: auto;
}

.admin-table {
    width: 100%;
    border-collapse: collapse;
}

.admin-table th,
.admin-table td {
    white-space: nowrap;
}

.module-panel {
    animation: aurea-module-in .18s ease;
}

@keyframes aurea-module-in {
    from {
        opacity: 0;
        transform: translateY(4px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}
.admin-login {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    background: #f5f4f0;
}

.admin-login-card {
    width: min(430px, 100%);
    padding: 42px;
    background: #fff;
    border: 1px solid #e5e3dc;
    border-radius: 18px;
    box-shadow: 0 24px 70px rgba(32, 32, 29, .10);
}

.admin-login-brand {
    color: #20201d;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: .16em;
}

.admin-login-brand span {
    display: block;
    margin-top: 5px;
    color: #9b8060;
    font-size: 11px;
    letter-spacing: .28em;
}

.admin-login-card h1 {
    margin: 34px 0 8px;
    color: #20201d;
    font-size: 28px;
}

.admin-login-card p {
    margin: 0 0 28px;
    color: #77766e;
    line-height: 1.6;
}

.admin-login-card label {
    display: block;
    margin-bottom: 8px;
    color: #20201d;
    font-size: 13px;
    font-weight: 600;
}

.admin-login-card input {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 14px;
    border: 1px solid #d9d7cf;
    border-radius: 9px;
    outline: none;
    font: inherit;
}

.admin-login-card input:focus {
    border-color: #9b8060;
    box-shadow: 0 0 0 3px #f1e9df;
}

.admin-login-card button {
    width: 100%;
    margin-top: 18px;
    padding: 14px;
    border: 0;
    border-radius: 9px;
    background: #20201d;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
}

.admin-login-card button:hover {
    background: #9b8060;
}

.admin-login-error {
    margin-top: 16px;
    padding: 12px;
    border-radius: 8px;
    background: #f8e9e9;
    color: #9a4e4e;
    font-size: 13px;
}

.admin-action-button,
.admin-primary-button {
    border: 0;
    border-radius: 8px;
    padding: 9px 13px;
    background: #20201d;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
}

.admin-action-button:hover,
.admin-primary-button:hover {
    background: #9b8060;
}

.admin-primary-button {
    margin-top: 20px;
    padding: 12px 18px;
}

.admin-order-status {
    min-width: 125px;
    padding: 7px 9px;
    border: 1px solid #ddd9d0;
    border-radius: 7px;
    background: #fff;
}

.admin-empty-cell {
    padding: 30px !important;
    text-align: center;
    color: #77766e;
}

.admin-json {
    margin: 0;
    padding: 20px;
    overflow: auto;
    background: #20201d;
    color: #eee;
    border-radius: 10px;
    font-size: 12px;
}

.admin-settings-form {
    max-width: 760px;
}

.settings-data-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 14px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #e5e3dc;
}

.settings-data-row label {
    color: #20201d;
    font-size: 13px;
    font-weight: 600;
}

.settings-data-row input {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 12px;
    border: 1px solid #ddd9d0;
    border-radius: 7px;
    font: inherit;
}

.admin-operation-grid {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0, 1fr));
    gap: 16px;
}

.admin-operation-grid > div {
    padding: 20px;
    border: 1px solid #e5e3dc;
    border-radius: 10px;
    background: #faf9f6;
}

.admin-operation-grid span {
    display: block;
    color: #77766e;
    font-size: 12px;
}

.admin-operation-grid strong {
    display: block;
    margin-top: 8px;
    color: #20201d;
    font-size: 24px;
}

@media (max-width: 800px) {

    .admin-operation-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .settings-data-row {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 520px) {

    .admin-operation-grid {
        grid-template-columns: 1fr;
    }
}

.admin-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
}

.admin-modal.is-open {
    display: block;
}

.admin-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 20, 18, .62);
    backdrop-filter: blur(3px);
}

.admin-modal-dialog {
    position: relative;
    width: min(720px, calc(100% - 32px));
    max-height: calc(100vh - 64px);
    margin: 32px auto;
    overflow: auto;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 30px 100px rgba(0, 0, 0, .25);
}

.admin-modal-header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    background: #fff;
    border-bottom: 1px solid #e5e3dc;
}

.admin-modal-header h2 {
    margin: 0;
    color: #20201d;
    font-size: 20px;
}

.admin-modal-close {
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: #f1f0eb;
    color: #20201d;
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
}

.admin-modal-close:hover {
    background: #e5e3dc;
}

.admin-modal-content {
    padding: 24px;
}

.admin-form {
    display: grid;
    gap: 18px;
}

.admin-form-grid {
    display: grid;
    grid-template-columns:
        repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.admin-form-field {
    display: grid;
    gap: 7px;
}

.admin-form-field.full {
    grid-column: 1 / -1;
}

.admin-form-field label {
    color: #20201d;
    font-size: 12px;
    font-weight: 700;
}

.admin-form-field input,
.admin-form-field select,
.admin-form-field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px;
    border: 1px solid #dcd9d1;
    border-radius: 8px;
    background: #fff;
    color: #20201d;
    font: inherit;
    outline: none;
}

.admin-form-field textarea {
    min-height: 110px;
    resize: vertical;
}

.admin-form-field input:focus,
.admin-form-field select:focus,
.admin-form-field textarea:focus {
    border-color: #9b8060;
    box-shadow:
        0 0 0 3px #f1e9df;
}

.admin-form-check {
    display: flex;
    align-items: center;
    gap: 9px;
}

.admin-form-check input {
    width: 17px;
    height: 17px;
}

.admin-form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding-top: 8px;
}

.admin-button-secondary {
    padding: 11px 18px;
    border: 1px solid #dcd9d1;
    border-radius: 8px;
    background: #fff;
    color: #20201d;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
}

.admin-button-primary {
    padding: 11px 18px;
    border: 0;
    border-radius: 8px;
    background: #20201d;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
}

.admin-button-primary:hover {
    background: #9b8060;
}

.admin-button-secondary:hover {
    background: #f5f4f0;
}

.admin-form-message {
    padding: 11px 13px;
    border-radius: 8px;
    font-size: 13px;
}

.admin-form-message.success {
    background: #e9f3ec;
    color: #47765b;
}

.admin-form-message.error {
    background: #f8e9e9;
    color: #9a4e4e;
}

@media (max-width: 650px) {

    .admin-form-grid {
        grid-template-columns: 1fr;
    }

    .admin-form-field.full {
        grid-column: auto;
    }

    .admin-modal-dialog {
        width: calc(100% - 20px);
        margin: 10px auto;
        max-height: calc(100vh - 20px);
    }

    .admin-modal-content {
        padding: 18px;
    }
}

.admin-toolbar-search {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
}

.admin-toolbar-search input {
    width: min(280px, 100%);
    padding: 10px 13px;
    border: 1px solid #dedbd3;
    border-radius: 8px;
    background: #fff;
    color: #20201d;
    outline: none;
}

.admin-toolbar-search input:focus {
    border-color: #9b8060;
    box-shadow: 0 0 0 3px #f1e9df;
}

.admin-toolbar-search input::placeholder {
    color: #8a887f;
}

.admin-table tbody tr[hidden] {
    display: none;
}

@media (max-width: 700px) {

    .admin-toolbar-search {
        width: 100%;
        margin-left: 0;
    }

    .admin-toolbar-search input {
        width: 100%;
    }
}

.admin-quick-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin: 0 0 18px;
}

.admin-row-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
}

.admin-action-button {
    padding: 7px 11px;
    border: 1px solid #dedbd3;
    border-radius: 7px;
    background: #fff;
    color: #20201d;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
}

.admin-action-button:hover {
    background: #f5f4f0;
    border-color: #9b8060;
}

.admin-primary-button {
    padding: 9px 15px;
    border: 0;
    border-radius: 8px;
    background: #20201d;
    color: #fff;
    cursor: pointer;
    font-weight: 700;
}

.admin-primary-button:hover {
    background: #9b8060;
}

.admin-operation-grid {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0, 1fr));
    gap: 14px;
}

@media (max-width: 900px) {

    .admin-operation-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {

    .admin-operation-grid {
        grid-template-columns: 1fr;
    }

    .admin-quick-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .admin-quick-actions button {
        width: 100%;
    }
}

.admin-global-search {
    position: relative;
    width: min(420px, 42vw);
    margin-left: auto;
}

.admin-global-search input {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 14px;
    border: 1px solid #dedbd3;
    border-radius: 9px;
    background: #fff;
    color: #20201d;
    outline: none;
}

.admin-global-search input:focus {
    border-color: #9b8060;
    box-shadow: 0 0 0 3px #f1e9df;
}

.admin-global-results {
    position: absolute;
    top: calc(100% + 7px);
    left: 0;
    right: 0;
    z-index: 500;
    overflow: hidden;
    border: 1px solid #e5e3dc;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 18px 50px rgba(0,0,0,.14);
}

.admin-global-result {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    padding: 12px 14px;
    border: 0;
    border-bottom: 1px solid #eeeae2;
    background: #fff;
    color: #20201d;
    text-align: left;
    cursor: pointer;
}

.admin-global-result:hover {
    background: #f8f6f1;
}

.admin-global-result strong {
    font-size: 13px;
}

.admin-global-result span {
    margin-top: 3px;
    color: #77766e;
    font-size: 11px;
}

.admin-global-empty {
    padding: 14px;
    color: #77766e;
    font-size: 13px;
}

@media (max-width: 900px) {

    .admin-global-search {
        width: 100%;
        margin: 12px 0 0;
        order: 10;
    }
}

@media (max-width: 650px) {

    .admin-sidebar {
        width: 78px;
    }

    .admin-sidebar span {
        display: none;
    }

    .admin-main,
    .admin-content {
        padding: 14px;
    }

    .admin-global-search {
        width: 100%;
    }

    .admin-table-wrap {
        overflow-x: auto;
    }

    .admin-table {
        min-width: 720px;
    }
}

.admin-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
}

.admin-status-badge.success {
    background: #e5f2e9;
    color: #47765b;
}

.admin-status-badge.danger {
    background: #f7e6e6;
    color: #9a4e4e;
}

.admin-notifications {
    display: grid;
    gap: 10px;
}

.admin-notification {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
}

.admin-notification strong {
    font-size: 13px;
}

.admin-notification span {
    color: var(--muted);
    font-size: 13px;
}

.admin-metrics-grid {
    display: grid;
    grid-template-columns: repeat(
        auto-fit,
        minmax(160px, 1fr)
    );
    gap: 14px;
}

.admin-metric-card {
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
}

.admin-metric-card span {
    display: block;
    color: var(--muted);
    font-size: 12px;
    margin-bottom: 8px;
}

.admin-metric-card strong {
    display: block;
    font-size: 24px;
}

.admin-session-status {
    display: flex;
    align-items: center;
}

/* ============================================================
   AUREA ADMIN — FINAL WEB ENVIRONMENT
   ============================================================ */

.admin-operational-content {
    display: grid;
    gap: 24px;
}

.admin-operation-grid {
    display: grid;
    grid-template-columns:
        minmax(0, 1.7fr)
        minmax(300px, 1fr);
    gap: 20px;
}

.admin-module-data {
    display: grid;
    gap: 20px;
}

.admin-json {
    margin: 0;
    padding: 20px;
    max-height: 520px;
    overflow: auto;
    border-radius: 14px;
    background: #20201d;
    color: #f5f4f0;
    font: 13px/1.6 Consolas, monospace;
    white-space: pre-wrap;
}

.admin-empty-state {
    padding: 30px;
    text-align: center;
    color: var(--muted);
    border: 1px dashed var(--border);
    border-radius: 12px;
}

.admin-error {
    padding: 18px;
    border: 1px solid #e1baba;
    background: #fff5f5;
    color: #8b3f3f;
    border-radius: 12px;
}

.module-panel {
    animation: aureaAdminEnter .22s ease-out;
}

@keyframes aureaAdminEnter {
    from {
        opacity: 0;
        transform: translateY(5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 980px) {
    .admin-operation-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {
    .admin-operation-grid {
        gap: 14px;
    }

    .admin-json {
        font-size: 11px;
    }
}
