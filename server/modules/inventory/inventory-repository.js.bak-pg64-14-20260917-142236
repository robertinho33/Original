'use strict';

const { query } = require('../../infrastructure/postgres');

async function getItem(sku) {
    const result = await query(
        `
        SELECT
            sku,
            product,
            stock,
            reserved,
            updated_at
        FROM inventory
        WHERE sku = $1
        `,
        [String(sku)]
    );

    if (result.rows.length === 0) {
        return null;
    }

    return {
        sku: result.rows[0].sku,
        product: result.rows[0].product,
        stock: Number(result.rows[0].stock),
        reserved: Number(result.rows[0].reserved),
        updatedAt: result.rows[0].updated_at
    };
}

async function getAllItems() {
    const result = await query(
        `
        SELECT
            sku,
            product,
            stock,
            reserved,
            updated_at
        FROM inventory
        ORDER BY sku
        `
    );

    return result.rows.map(row => ({
        sku: row.sku,
        product: row.product,
        stock: Number(row.stock),
        reserved: Number(row.reserved),
        updatedAt: row.updated_at
    }));
}

async function saveItem(item) {
    if (!item?.sku) {
        throw new Error('SKU obrigatória para estoque.');
    }

    const result = await query(
        `
        INSERT INTO inventory (
            sku,
            product,
            stock,
            reserved
        )
        VALUES ($1, $2, $3, $4)
        ON CONFLICT (sku)
        DO UPDATE SET
            product = EXCLUDED.product,
            stock = EXCLUDED.stock,
            reserved = EXCLUDED.reserved,
            updated_at = NOW()
        RETURNING
            sku,
            product,
            stock,
            reserved,
            updated_at
        `,
        [
            String(item.sku),
            item.product || null,
            Number(item.stock || 0),
            Number(item.reserved || 0)
        ]
    );

    const row = result.rows[0];

    return {
        sku: row.sku,
        product: row.product,
        stock: Number(row.stock),
        reserved: Number(row.reserved),
        updatedAt: row.updated_at
    };
}

async function updateItem(sku, patch) {
    const current = await getItem(sku);

    if (!current) {
        return null;
    }

    const product =
        patch.product !== undefined
            ? patch.product
            : current.product;

    const stock =
        patch.stock !== undefined
            ? Number(patch.stock)
            : current.stock;

    const reserved =
        patch.reserved !== undefined
            ? Number(patch.reserved)
            : current.reserved;

    return saveItem({
        sku: String(sku),
        product,
        stock,
        reserved
    });
}

async function saveReservation(reservation) {
    if (!reservation?.id) {
        throw new Error('Reserva inválida.');
    }

    const orderNumber =
        reservation.orderNumber ||
        null;

    const result = await query(
        `
        INSERT INTO inventory (
            sku,
            product,
            stock,
            reserved
        )
        VALUES ($1, $2, $3, $4)
        ON CONFLICT (sku)
        DO UPDATE SET
            reserved = inventory.reserved + EXCLUDED.reserved,
            updated_at = NOW()
        RETURNING
            sku,
            product,
            stock,
            reserved,
            updated_at
        `,
        [
            `__reservation__${reservation.id}`,
            JSON.stringify({
                id: reservation.id,
                orderNumber,
                sku: reservation.sku || null,
                quantity: Number(reservation.quantity || 0),
                status: reservation.status || 'reserved'
            }),
            0,
            Number(reservation.quantity || 0)
        ]
    );

    return {
        ...reservation,
        orderNumber,
        persistedAt: result.rows[0].updated_at
    };
}

async function getReservation(id) {
    const result = await query(
        `
        SELECT
            sku,
            product,
            reserved,
            updated_at
        FROM inventory
        WHERE sku = $1
        `,
        [`__reservation__${id}`]
    );

    if (result.rows.length === 0) {
        return null;
    }

    let data = {};

    try {
        data = JSON.parse(
            result.rows[0].product || '{}'
        );
    } catch {
        data = {};
    }

    return {
        ...data,
        id: id,
        quantity: Number(result.rows[0].reserved || 0),
        persistedAt: result.rows[0].updated_at
    };
}

async function deleteReservation(id) {
    await query(
        `
        DELETE FROM inventory
        WHERE sku = $1
        `,
        [`__reservation__${id}`]
    );
}

async function getAllReservations() {
    const result = await query(
        `
        SELECT
            sku,
            product,
            reserved,
            updated_at
        FROM inventory
        WHERE sku LIKE '__reservation__%'
        ORDER BY updated_at DESC
        `
    );

    return result.rows.map(row => {
        let data = {};

        try {
            data = JSON.parse(
                row.product || '{}'
            );
        } catch {
            data = {};
        }

        return {
            ...data,
            id: data.id || row.sku.replace('__reservation__', ''),
            quantity: Number(row.reserved || 0),
            persistedAt: row.updated_at
        };
    });
}

module.exports = {
    getItem,
    getAllItems,
    saveItem,
    updateItem,
    saveReservation,
    getReservation,
    deleteReservation,
    getAllReservations
};
